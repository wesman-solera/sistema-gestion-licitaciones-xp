@model ListadoViewModel<OfertaDto>
@{
    ViewData["Title"] = "Ofertas";
    var licitaciones = ViewData["Licitaciones"] as IReadOnlyList<LicitacionResumenDto> ?? [];
    var proveedores = ViewData["Proveedores"] as IReadOnlyList<ProveedorDto> ?? [];
    var licitacionFiltrada = ViewData["LicitacionFiltrada"] as Guid?;
    var proveedorFiltrado = ViewData["ProveedorFiltrado"] as Guid?;
}

<div class="encabezado-pagina">
    <div>
        <h1>Ofertas</h1>
        <p>Propuestas economicas presentadas por los proveedores.</p>
    </div>
    <a class="boton boton--primario" asp-action="Crear">Registrar oferta</a>
</div>

<div class="tarjeta">
    <form method="get" class="filtros">
        <div class="campo">
            <label for="licitacionId">Licitacion</label>
            <select id="licitacionId" name="licitacionId">
                <option value="">Todas</option>
                @foreach (LicitacionResumenDto licitacion in licitaciones)
                {
                    <option value="@licitacion.Id" selected="@(licitacionFiltrada == licitacion.Id)">
                        @licitacion.Codigo &mdash; @licitacion.Titulo
                    </option>
                }
            </select>
        </div>
        <div class="campo">
            <label for="proveedorId">Proveedor</label>
            <select id="proveedorId" name="proveedorId">
                <option value="">Todos</option>
                @foreach (ProveedorDto proveedor in proveedores)
                {
                    <option value="@proveedor.Id" selected="@(proveedorFiltrado == proveedor.Id)">@proveedor.Nombre</option>
                }
            </select>
        </div>
        <div class="grupo-botones">
            <button type="submit" class="boton boton--secundario">Filtrar</button>
            <a class="boton boton--secundario" asp-action="Index">Limpiar</a>
        </div>
    </form>

    @if (Model.Pagina.Elementos.Count == 0)
    {
        <p class="sin-datos">No hay ofertas que coincidan con el filtro aplicado.</p>
    }
    else
    {
        <div class="tabla-contenedor">
            <table class="tabla">
                <caption class="solo-lectores">Listado de ofertas registradas</caption>
                <thead>
                    <tr>
                        <th scope="col">
                            <a asp-all-route-data="@Model.ValoresRuta(pagina: 1, ordenarPor: "licitacion", descendente: Model.ProximaDireccion("licitacion"))">Licitacion</a>
                        </th>
                        <th scope="col">
                            <a asp-all-route-data="@Model.ValoresRuta(pagina: 1, ordenarPor: "proveedor", descendente: Model.ProximaDireccion("proveedor"))">Proveedor</a>
                        </th>
                        <th scope="col" class="numerico">
                            <a asp-all-route-data="@Model.ValoresRuta(pagina: 1, ordenarPor: "monto", descendente: Model.ProximaDireccion("monto"))">Monto</a>
                        </th>
                        <th scope="col">Registrada</th>
                        <th scope="col"><span class="solo-lectores">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (OfertaDto oferta in Model.Pagina.Elementos)
                    {
                        <tr data-oferta="@oferta.Id">
                            <td>
                                <a asp-controller="Licitaciones" asp-action="Detalle" asp-route-id="@oferta.LicitacionId">
                                    @oferta.CodigoLicitacion
                                </a>
                            </td>
                            <td>@oferta.NombreProveedor</td>
                            <td class="numerico" data-monto>
                                @Montos.Formatear(oferta.Monto)
                                @if (oferta.EsMejorOferta)
                                {
                                    <span class="etiqueta etiqueta--mejor">Mejor</span>
                                }
                            </td>
                            <td>@FormateadorFecha.FechaHora(oferta.FechaRegistro)</td>
                            <td>
                                <div class="grupo-botones">
                                    <a class="boton boton--secundario boton--pequeno" asp-action="Editar" asp-route-id="@oferta.Id">Editar</a>
                                    <a class="boton boton--secundario boton--pequeno" asp-action="Eliminar" asp-route-id="@oferta.Id">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Paginacion" model="PaginacionViewModel.Desde(Model)" />
    }
</div>
