@model ListadoViewModel<NivelAprobacionDto>
@{
    ViewData["Title"] = "Niveles de aprobacion";
}

<div class="encabezado-pagina">
    <div>
        <h1>Niveles de aprobacion</h1>
        <p>Tabla parametrizable que determina quien aprueba segun el monto de la mejor oferta.</p>
    </div>
    <a class="boton boton--primario" asp-action="Crear">Nuevo rango</a>
</div>

<div class="tarjeta">
    <div class="mensaje mensaje--info" role="note">
        <span aria-hidden="true">&#9432;</span>
        <span>
            Los rangos no pueden traslaparse entre si y solo puede existir un rango abierto,
            es decir uno sin monto maximo. El sistema rechaza cualquier cambio que rompa esas
            condiciones.
        </span>
    </div>

    @if (Model.Pagina.Elementos.Count == 0)
    {
        <p class="sin-datos">Todavia no hay rangos de aprobacion configurados.</p>
    }
    else
    {
        <div class="tabla-contenedor">
            <table class="tabla">
                <caption class="solo-lectores">Rangos de aprobacion configurados</caption>
                <thead>
                    <tr>
                        <th scope="col" class="numerico">Monto minimo</th>
                        <th scope="col" class="numerico">Monto maximo</th>
                        <th scope="col">Aprobador</th>
                        <th scope="col"><span class="solo-lectores">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (NivelAprobacionDto nivel in Model.Pagina.Elementos)
                    {
                        <tr data-nivel="@nivel.Aprobador">
                            <td class="numerico" data-monto>@Montos.Formatear(nivel.MontoMinimo)</td>
                            <td class="numerico" data-monto>
                                @if (nivel.EsRangoAbierto)
                                {
                                    <span class="etiqueta etiqueta--publicada">Sin limite</span>
                                }
                                else
                                {
                                    @Montos.Formatear(nivel.MontoMaximo)
                                }
                            </td>
                            <td>@nivel.Aprobador</td>
                            <td>
                                <div class="grupo-botones">
                                    <a class="boton boton--secundario boton--pequeno" asp-action="Editar" asp-route-id="@nivel.Id">Editar</a>
                                    <a class="boton boton--secundario boton--pequeno" asp-action="Eliminar" asp-route-id="@nivel.Id">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Paginacion" model="PaginacionViewModel.Desde(Model)" />
    }
</div>
