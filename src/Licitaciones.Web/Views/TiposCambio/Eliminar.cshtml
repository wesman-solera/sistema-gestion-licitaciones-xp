@model TipoCambioDto
@{
    ViewData["Title"] = "Eliminar tipo de cambio";
}

<div class="encabezado-pagina">
    <div>
        <h1>Eliminar tipo de cambio</h1>
        <p>Esta accion requiere confirmacion.</p>
    </div>
</div>

<div class="tarjeta">
    <div class="mensaje mensaje--advertencia" role="alert">
        <span aria-hidden="true">&#9888;</span>
        <span>
            El registro se eliminara de forma definitiva. El tipo de cambio activo no puede
            eliminarse: primero debe activarse otro.
        </span>
    </div>

    <dl class="definiciones">
        <div>
            <dt>Colones por dolar</dt>
            <dd>@FormateadorMonto.FormatearColones(Model.CrcPorUsd)</dd>
        </div>
        <div>
            <dt>Vigencia</dt>
            <dd>@FormateadorFecha.Fecha(Model.FechaVigencia)</dd>
        </div>
        <div>
            <dt>Estado</dt>
            <dd>@(Model.Activo ? "Activo" : "Inactivo")</dd>
        </div>
    </dl>

    <form method="post" asp-action="Eliminar" asp-route-id="@Model.Id" data-una-vez>
        <div class="grupo-botones">
            <button type="submit" class="boton boton--peligro">Si, eliminar</button>
            <a class="boton boton--secundario" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
