@model TipoCambioFormulario
@{
    ViewData["Title"] = "Editar tipo de cambio";
}

<div class="encabezado-pagina">
    <div>
        <h1>Editar tipo de cambio</h1>
        <p>Vigente desde el @Model.FechaVigencia.ToString("dd/MM/yyyy")</p>
    </div>
</div>

<div class="tarjeta">
    <form method="post" asp-action="Editar" asp-route-id="@Model.Id" data-una-vez>
        <input type="hidden" asp-for="Id" />

        <partial name="_Formulario" model="Model" />

        <div class="grupo-botones">
            <button type="submit" class="boton boton--primario">Guardar cambios</button>
            <a class="boton boton--secundario" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
