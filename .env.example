# Plantilla de variables de entorno.
#
# Copie este archivo como .env y ajuste los valores. El archivo .env esta excluido del
# repositorio: la seccion 11 del enunciado prohibe versionar credenciales reales.

# --- PostgreSQL ---
POSTGRES_DB=licitaciones
POSTGRES_USER=licitaciones_app
POSTGRES_PASSWORD=cambie_esta_clave

# --- Aplicacion ---
# La cadena de conexion usa el nombre del servicio de Docker Compose como host.
ConnectionStrings__Licitaciones=Host=postgres;Port=5432;Database=licitaciones;Username=licitaciones_app;Password=cambie_esta_clave
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
